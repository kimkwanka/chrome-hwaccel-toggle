{
  "manifest_version": 3,
  "name": "Hardware Acceleration Toggle",
  "version": "1.0.0",
  "description": "Toggle the browser's hardware acceleration in one click (needs the local native helper).",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Hardware acceleration",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "toggle-hwaccel": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Toggle hardware acceleration and restart the browser"
    }
  }
}
